meta {
  name: Send a notification
  type: http
  seq: 1
}

post {
  url: https://notifi.it/send
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NOTIFI_KEY}}
}

headers {
  Content-Type: application/json
}

body:json {
    {
      "title": "Hello from notifi",
      "message": "Your first notification.",
      "link": "https://notifi.it/docs",
      "image": "https://notifi.it/sad-logo.png"
    }
}

docs {
  Push notifications to an iPhone, iPad or Mac from one HTTP request.

  Set NOTIFI_KEY to the send key from the app's Keys tab, then send. A 202 with
  {"ok":true} means the server accepted it, not that it was delivered.

  Reference: https://notifi.it/docs
}
