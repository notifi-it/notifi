<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>notifi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save notification images to your photo library.</string>
	<key>UIAppFonts</key>
	<array>
		<string>RecursiveMono-Regular.ttf</string>
		<string>RecursiveMono-Medium.ttf</string>
		<string>RecursiveMono-SemiBold.ttf</string>
		<string>RecursiveMono-Bold.ttf</string>
		<string>RecursiveMono-ExtraBold.ttf</string>
		<string>RecursiveMono-Black.ttf</string>
			<string>Karla.ttf</string>
			<string>Karla-Italic.ttf</string>
	</array>
	<!-- The app seals notification bodies with HPKE (P256_SHA256_AES_GCM_256) and
	     signs requests with a Secure Enclave P-256 key, but every one of those
	     primitives comes from the operating system: `otool -L` on the signed
	     binary shows CryptoKit and Security under /System/Library and no embedded
	     frameworks at all. App Store Connect asks for documentation only when an
	     app uses proprietary algorithms, or standard ones instead of or in
	     addition to the encryption inside Apple's OS. Neither is true here.

	     This said `true` for one afternoon and every upload failed at ingest with
	     "Invalid Export Compliance Code ... [] doesn't match", because `true`
	     obliges the bundle to carry an ITSEncryptionExportComplianceCode from
	     approved documentation, and this app has none on file — nor needs any.
	     Declaring it either way is what stops the question being asked once per
	     build and parking every TestFlight upload on a click. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The launch screen follows the system scheme, not the appearance chosen
	     in Settings — no code runs yet, so it cannot know. Both assets carry
	     light and dark variants; the one frame where the two schemes disagree
	     beats the white flash an empty dict produced on the default dark app. -->
	<!-- A storyboard, not the UILaunchScreen dict: the dict's background is a
	     colour only, and the launch screen carries grain behind the bell so the
	     first paint of the app is not a visible change of surface. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- iPhone keeps three: upside-down on a phone puts the earpiece at the
	     bottom, and iOS ignores it on notched hardware anyway. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad has to offer all four or App Store Connect refuses the upload
	     outright: TARGETED_DEVICE_FAMILY is "1,2", and an iPad app that cannot
	     be used in every orientation cannot hold up its half of a Split View.
	     A three-orientation build failed validation with a 409 before this key
	     existed, after a clean build and a full upload — the check is Apple's,
	     at ingest, not Xcode's. There is no home button to point down on any
	     iPad that runs this, so the fourth orientation costs nothing. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
