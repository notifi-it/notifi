<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>notifi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save notification images to your photo library.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Inconsolata.ttf</string>
			<string>Karla.ttf</string>
	</array>
	<!-- True because the app does more than call HTTPS: it seals notification
	     bodies to the device with HPKE (P256_SHA256_AES_GCM_256) and signs
	     requests with a Secure Enclave P-256 key. None of Apple's "answer false"
	     exemptions cover that — they stop at OS-provided TLS, authentication-only
	     use, and keys of 56 bits or fewer. Declaring it here rather than in App
	     Store Connect also stops the question being asked once per build, which
	     otherwise parks every TestFlight upload until someone clicks through it.
	     Claiming the mass-market exemption for it is a separate, human step: see
	     "Export compliance" in the README. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- iPhone keeps three: upside-down on a phone puts the earpiece at the
	     bottom, and iOS ignores it on notched hardware anyway. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad has to offer all four or App Store Connect refuses the upload
	     outright: TARGETED_DEVICE_FAMILY is "1,2", and an iPad app that cannot
	     be used in every orientation cannot hold up its half of a Split View.
	     A three-orientation build failed validation with a 409 before this key
	     existed, after a clean build and a full upload — the check is Apple's,
	     at ingest, not Xcode's. There is no home button to point down on any
	     iPad that runs this, so the fourth orientation costs nothing. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
