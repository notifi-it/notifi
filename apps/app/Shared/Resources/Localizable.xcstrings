    "keyDetail.criticalChangeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change critical alerts for this key. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cambiar las alertas críticas de esta clave. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Benachrichtigungen für diesen Schlüssel konnten nicht geändert werden. Verbindung prüfen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier les alertes critiques pour cette clé. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare gli avvisi critici per questa chiave. Controlla la connessione e riprova."
          }
        }
      }
    },
    "keyDetail.criticalNotPermitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical Alerts are turned off for notifi in system settings. These will still break through Focus, but they will not sound through silent mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas críticas están desactivadas para notifi en los ajustes del sistema. Seguirán atravesando el modo Enfoque, pero no sonarán con el modo silencio activado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Benachrichtigungen sind für notifi in den Systemeinstellungen deaktiviert. Sie durchbrechen weiterhin den Fokus, ertönen aber nicht im Stummmodus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes critiques sont désactivées pour notifi dans les réglages système. Elles franchiront quand même Focus, mais ne sonneront pas malgré le mode silencieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi critici sono disattivati per notifi nelle impostazioni di sistema. Continueranno a superare Focus, ma non suoneranno in modalità silenziosa."
          }
        }
      }
    },
    "keyDetail.criticalOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends from this key that ask for it will sound through silent mode and Focus. Add is_critical=1 to the send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los envíos de esta clave que lo soliciten sonarán incluso con el modo silencio y el modo Enfoque activados. Añade is_critical=1 al envío."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendungen von diesem Schlüssel, die es anfordern, ertönen auch im Stumm- und Fokusmodus. is_critical=1 zur Sendung hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les envois de cette clé qui le demandent sonneront malgré le mode silencieux et Focus. Ajoutez is_critical=1 à l’envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli invii da questa chiave che lo richiedono suoneranno anche in modalità silenziosa e con Focus attivo. Aggiungi is_critical=1 all'invio."
          }
        }
      }
    },
    "keyDetail.criticalTimeSensitive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends from this key that ask for it break through Focus and stay on the lock screen. Add is_critical=1 to the send. They will not sound through silent mode. That needs an entitlement Apple has yet to grant notifi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los envíos de esta clave que lo soliciten atravesarán el modo Enfoque y permanecerán en la pantalla de bloqueo. Añade is_critical=1 al envío. No sonarán con el modo silencio activado. Eso requiere una autorización que Apple aún no ha concedido a notifi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendungen von diesem Schlüssel, die es anfordern, durchbrechen den Fokus und bleiben auf dem Sperrbildschirm. is_critical=1 zur Sendung hinzufügen. Sie ertönen nicht im Stummmodus. Dafür ist eine Berechtigung nötig, die Apple notifi noch nicht erteilt hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les envois de cette clé qui le demandent franchissent Focus et restent sur l’écran verrouillé. Ajoutez is_critical=1 à l’envoi. Ils ne sonneront pas malgré le mode silencieux. Cela nécessite une habilitation qu’Apple n’a pas encore accordée à notifi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli invii da questa chiave che lo richiedono superano Focus e restano sulla schermata di blocco. Aggiungi is_critical=1 all'invio. Non suoneranno in modalità silenziosa. Serve un'autorizzazione che Apple non ha ancora concesso a notifi."
          }
        }
      }
    },
    "keyDetail.defaultKeyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi keeps this one on your device, so you can copy it again whenever you need it, or regenerate it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi guarda esta en tu dispositivo, así que puedes volver a copiarla cuando la necesites, o regenerarla más abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi behält diesen auf deinem Gerät, sodass du ihn jederzeit erneut kopieren oder unten neu erzeugen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi conserve celle-ci sur votre appareil, vous pouvez donc la copier à nouveau quand vous en avez besoin, ou la régénérer ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi conserva questa chiave sul tuo dispositivo, così puoi copiarla di nuovo quando ti serve, oppure rigenerarla qui sotto."
          }
        }
      }
    },
