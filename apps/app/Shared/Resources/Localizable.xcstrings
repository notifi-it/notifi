    "keyDetail.openAnyLinkDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, only https links open. On, other schemes open too, including ones that launch other apps on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, solo se abren enlaces https. Activado, también se abren otros esquemas, incluidos los que lanzan otras apps en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus, es öffnen nur https-Links. An, es öffnen auch andere Schemata, einschließlich solcher, die andere Apps auf diesem Gerät starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, seuls les liens https s’ouvrent. Activé, d’autres schémas s’ouvrent aussi, y compris ceux qui lancent d’autres applications sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato, si aprono solo i link https. Attivato, si aprono anche altri schemi, inclusi quelli che avviano altre app su questo dispositivo."
          }
        }
      }
    },
