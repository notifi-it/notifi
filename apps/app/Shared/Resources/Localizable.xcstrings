    "settings.loadImagesDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches each image as the notification arrives, which tells its host your IP address. Off, images load only when tapped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene cada imagen al llegar el mensaje, lo que informa tu dirección IP a su host. Desactivado, las imágenes solo se cargan al pulsarlas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft jedes Bild ab, sobald die Nachricht ankommt, was dem Host deine IP-Adresse verrät. Aus, Bilder laden erst bei Antippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère chaque image dès l'arrivée du message, ce qui révèle votre adresse IP à son hôte. Désactivé, les images ne se chargent qu'au toucher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera ogni immagine all'arrivo del messaggio, il che comunica al suo host il tuo indirizzo IP. Disattivato, le immagini si caricano solo quando vengono toccate."
          }
        }
      }
    },
