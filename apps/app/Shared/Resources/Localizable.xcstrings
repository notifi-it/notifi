            "state": "translated",
            "value": "Gerade zu viele Anfragen. In einem Moment erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de requêtes à l’instant. Réessayez dans un moment."
