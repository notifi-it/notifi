    "clientErrors.decoding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned something unexpected. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor devolvió algo inesperado. Inténtalo de nuevo en un momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat etwas Unerwartetes zurückgegeben. In einem Moment erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé une réponse inattendue. Réessayez dans un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha restituito qualcosa di inatteso. Riprova tra un momento."
          }
        }
      }
    },
    "clientErrors.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request didn't go through. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud no se pudo completar. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage kam nicht durch. Erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n'a pas abouti. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta non è andata a buon fine. Riprova."
          }
        }
      }
    },
    "clientErrors.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is no longer on the server. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso ya no está en el servidor. Actualiza e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht mehr auf dem Server. Aktualisieren und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est plus sur le serveur. Actualisez et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è più sul server. Aggiorna e riprova."
          }
        }
      }
    },
    "clientErrors.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests just now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
