    "unsupported.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi requires a Mac with Apple silicon or a T2 chip. This Mac has no Secure Enclave, which notifi uses to protect your identity key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi requiere un Mac con Apple silicon o un chip T2. Este Mac no tiene Secure Enclave, que notifi usa para proteger tu clave de identidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi benötigt einen Mac mit Apple Silicon oder einem T2-Chip. Dieser Mac hat keine Secure Enclave, die notifi zum Schutz deines Identitätsschlüssels verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi nécessite un Mac avec puce Apple silicon ou puce T2. Ce Mac n'a pas d'Enclave sécurisée, que notifi utilise pour protéger votre clé d'identité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "notifi richiede un Mac con chip Apple Silicon o chip T2. Questo Mac non ha una Secure Enclave, che notifi usa per proteggere la tua chiave di identità."
          }
        }
      }
    },
