    "keyDetail.regeneratedAnnouncement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key regenerated. The old value no longer works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave regenerada. El valor anterior ya no funciona."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel neu erzeugt. Der alte Wert funktioniert nicht mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé régénérée. L'ancienne valeur ne fonctionne plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave rigenerata. Il vecchio valore non funziona più."
          }
        }
      }
    },
    "keyDetail.regenerateDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerating issues a new value and retires the old one. Anything still sending with the old value will be rejected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerar emite un nuevo valor y retira el anterior. Cualquier envío que siga usando el valor anterior será rechazado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Neuerzeugen entsteht ein neuer Wert, der alte wird stillgelegt. Alles, was noch mit dem alten Wert sendet, wird abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régénérer émet une nouvelle valeur et retire l'ancienne. Tout ce qui envoie encore avec l'ancienne valeur sera rejeté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rigenerazione emette un nuovo valore e ritira quello vecchio. Qualsiasi invio ancora effettuato con il vecchio valore verrà rifiutato."
          }
        }
      }
    },
    "keyDetail.regenerateFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't regenerate the key. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo regenerar la clave. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel konnte nicht neu erzeugt werden. Verbindung prüfen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de régénérer la clé. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rigenerare la chiave. Controlla la connessione e riprova."
          }
        }
      }
    },
    "keyDetail.regenerateMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current value stops working immediately, and anything still sending with it will be rejected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor actual deja de funcionar de inmediato, y cualquier envío que siga usándolo será rechazado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Wert funktioniert sofort nicht mehr, und alles, was noch damit sendet, wird abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur actuelle cesse de fonctionner immédiatement, et tout ce qui envoie encore avec elle sera rejeté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore attuale smette di funzionare immediatamente, e qualsiasi invio ancora effettuato con esso verrà rifiutato."
          }
        }
      }
    },
