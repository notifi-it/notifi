    "keyDetail.revokeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoking is permanent. Anything still sending to this key will be rejected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar es permanente. Cualquier envío que siga dirigido a esta clave será rechazado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Widerrufen ist endgültig. Alles, was noch an diesen Schlüssel sendet, wird abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révocation est définitive. Tout ce qui envoie encore à cette clé sera rejeté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revoca è permanente. Qualsiasi invio ancora effettuato verso questa chiave verrà rifiutato."
          }
        }
      }
    },
