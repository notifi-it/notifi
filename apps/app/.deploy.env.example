# Optional. Credentials are read from the login Keychain first (service
# notifi-release, as in converse-ios); this file is the fallback.
#
#   security add-generic-password -A -U -s notifi-release -a asc-key-id    -w '<key id>'
#   security add-generic-password -A -U -s notifi-release -a asc-issuer-id -w '<issuer uuid>'
#
# To use a file instead, copy this to apps/app/.deploy.env (gitignored) and fill in.

# Apple Developer team id. Optional — if unset it is read from the
# "Developer ID Application" certificate in your keychain.
TEAM_ID=

# App Store Connect API key (Users and Access -> Integrations -> App Store Connect API).
# App Manager is enough to upload builds and notarize. It is NOT enough to create
# provisioning profiles over the API, which is why signing uses your Xcode account.
ASC_KEY_ID=
ASC_ISSUER_ID=

# Path to the AuthKey_<ASC_KEY_ID>.p8. Optional if the file is in
# ~/.appstoreconnect/private_keys/ or ~/private_keys/.
ASC_KEY_PATH=

# Optional overrides. Version defaults to project.yml; the build number defaults to
# a YYYYMMDDHHMM clock stamp, which always increases.
# MARKETING_VERSION=1.0
# BUILD_NUMBER=
